# Maven Wrapper 脚本
/mvnw text eol=lf
*.cmd text eol=crlf

# 源代码文件统一使用 LF
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf

# 前端文件
*.js text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf

# 二进制文件（不进行换行符转换）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.class binary
