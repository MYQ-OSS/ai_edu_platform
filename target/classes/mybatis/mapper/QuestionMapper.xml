<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.mayiqin.ai_edu_platform.mapper.QuestionMapper">

    <resultMap id="BaseResultMap" type="top.mayiqin.ai_edu_platform.entity.po.Question">
            <id property="id" column="id" />
            <result property="questionName" column="question_name" />
            <result property="questionDesc" column="question_desc" />
            <result property="options" column="options" />
            <result property="targetSalary" column="target_salary" />
            <result property="direction" column="direction" />
            <result property="analysis" column="analysis" />
            <result property="createTime" column="create_time" />
    </resultMap>

    <sql id="Base_Column_List">
        id,question_name,question_desc,options,target_salary,direction,
        analysis,create_time
    </sql>
</mapper>
